# Copy to server/.env and adjust. Every value is optional in development.

# --- Core ---
NODE_ENV=development
PORT=5000
# Public URL of the site, used in email links (development: the Vite dev server).
APP_URL=http://localhost:5173

# --- Database ---
# Leave empty in development to use the embedded MongoDB stored in server/.data/db.
# In production use MongoDB Atlas, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGO_URI=
DB_NAME=localfix

# --- Security ---
# REQUIRED in production: a long random string (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
SESSION_HOURS=12

# --- Email (optional) ---
# Without SMTP, emails are printed to the server console and dev links are shown on screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LocalFix <no-reply@localfix.test>
# Force email verification on or off (default: on in development, on in production only if SMTP is set)
REQUIRE_EMAIL_VERIFICATION=

# --- Data ---
# Load the sample data automatically when the database is empty.
AUTO_SEED=true
# Where uploaded images are stored (relative to server/). Use a persistent disk in production.
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=uploads-private

# --- Third-party APIs (all optional, none needs an account) ---
# Set to false to switch off every outbound call; features fall back gracefully.
EXTERNAL_APIS=true
# Override only to point at self-hosted instances.
PHOTON_URL=
NOMINATIM_URL=
OSRM_URL=
OPEN_METEO_URL=

# --- AI request assistant (optional) ---
# With a key the assistant uses the Claude API; without one a built-in rule engine answers.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Web Push (optional) ---
# Leave empty to generate a key pair once and store it in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@localfix.test
